# Production Caddy for atlasmsg.app. Keep /mcp, /api, /ws, /s on the API.
atlasmsg.app {
	encode gzip zstd
	root * /opt/atlas/server/web/dist
	handle /s/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /ws* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /canvas* {
		rewrite * /canvas/index.html
		file_server
	}
	handle /mcp* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /app* {
		try_files {path} {path}/ /app/index.html
		file_server
	}
	handle /privacy* {
		rewrite * /privacy/index.html
		file_server
	}
	handle /terms* {
		rewrite * /terms/index.html
		file_server
	}
	handle /oferta* {
		rewrite * /oferta/index.html
		file_server
	}
	handle {
		try_files {path} {path}/ /index.html
		file_server
	}
}

s.atlasmsg.app {
	encode gzip zstd
	reverse_proxy 127.0.0.1:8080
}

ai.atlasmsg.app {
	encode gzip zstd
	reverse_proxy 127.0.0.1:8080
}
