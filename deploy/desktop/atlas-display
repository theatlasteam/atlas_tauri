#!/bin/sh
# atlas-display N — boot Xvnc :N + Xfce + websockify for one Mind's screen.
# Idempotent: if the VNC port already answers, the display is up — do nothing.
set -eu

N="${1:?usage: atlas-display N}"
VNC_PORT=$((15900 + N))
NOVNC_PORT=$((16900 + N))
HOME_DIR="/home/desktop/mind-${N}"
GEOM="${ATLAS_GEOM:-1280x800}"

mkdir -p "$HOME_DIR"
export HOME="$HOME_DIR"

if (exec 3<>/dev/tcp/127.0.0.1/$VNC_PORT) 2>/dev/null; then
  exec 3>&- 3<&-
  exit 0
fi

# Fresh X authority per display so sessions never share cookies.
XAUTHORITY="$HOME_DIR/.Xauthority"
export XAUTHORITY
rm -f "$XAUTHORITY"
touch "$XAUTHORITY"
xauth generate ":$N" . trusted >/dev/null 2>&1 || true

# One password for all automation VNC access; the owner never types it —
# viewing goes through the server-side proxy, and AI input via xdotool.
STORE_PASS="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' | head -c 8)"
echo "$STORE_PASS" | vncpasswd -f > "$HOME_DIR/.vnc-passwd"
chmod 600 "$HOME_DIR/.vnc-passwd"

vncserver ":$N" \
  -geometry "$GEOM" \
  -depth 24 \
  -localhost no \
  -rfbport "$VNC_PORT" \
  -PasswordFile "$HOME_DIR/.vnc-passwd" \
  >/tmp/vnc-$N.log 2>&1

export DISPLAY=":$N"
# Minimal session: window manager + panel + file manager, no screensaver or
# lock (a locked screen the Mind can't unlock is a bricked screen).
(startxfce4 >/tmp/xfce-$N.log 2>&1 &) || (xfwm4 & xfce4-panel & thunar --daemon &)
sleep 2
xset s off -dpms 2>/dev/null || true

# Chromium with a per-screen profile, kiosk-calm: no first-run, no password
# bubbles, restores cleanly after container restarts.
(ungoogled-chromium \
  --user-data-dir="$HOME_DIR/chromium" \
  --no-first-run \
  --no-default-browser-check \
  --disable-features=Translate \
  --password-store=basic \
  --start-maximized \
  about:blank >/tmp/chromium-$N.log 2>&1 &) || \
(chromium \
  --user-data-dir="$HOME_DIR/chromium" \
  --no-first-run \
  --no-default-browser-check \
  --start-maximized \
  about:blank >/tmp/chromium-$N.log 2>&1 &) || true

# noVNC bridge: the server proxies {novnc_port} — the browser never talks
# VNC directly.
websockify --web /usr/share/novnc "$NOVNC_PORT" "127.0.0.1:$VNC_PORT" \
  >/tmp/novnc-$N.log 2>&1 &
disown -a || true
exit 0
