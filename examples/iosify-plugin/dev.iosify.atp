{
  "atp": 1,
  "plugin": {
    "pluginId": "dev.iosify",
    "name": "iOSify",
    "version": "0.1.0",
    "description": "Restyles the whole app like iOS: system-blue accent, liquid-glass gradients, squircle avatars and controls (not circles), inset grouped lists without descriptions, SF-style rounded type, and iOS-native switches, dialogs, tab bar and rail.",
    "author": "",
    "files": {
      "dev.iosify.atp": "{\n  \"atp\": 1,\n  \"plugin\": {\n    \"pluginId\": \"dev.iosify\",\n    \"name\": \"iOSify\",\n    \"version\": \"0.1.0\",\n    \"description\": \"Restyles the whole app like iOS: system-blue accent, liquid-glass gradients, squircle avatars and controls (not circles), inset grouped lists without descriptions, SF-style rounded type, and iOS-native switches, dialogs, tab bar and rail.\",\n    \"author\": \"\",\n    \"files\": {\n      \"icon.svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><rect x=\\\"2\\\" y=\\\"4\\\" width=\\\"20\\\" height=\\\"16\\\" rx=\\\"5\\\"/><path d=\\\"M7 9h10M7 13h10\\\"/></svg>\\n\",\n      \"manifest.json\": \"{\\n  \\\"id\\\": \\\"dev.iosify\\\",\\n  \\\"name\\\": \\\"iOSify\\\",\\n  \\\"version\\\": \\\"0.1.0\\\",\\n  \\\"description\\\": \\\"Restyles the whole app like iOS: system-blue accent, liquid-glass gradients, squircle avatars and controls (not circles), inset grouped lists without descriptions, SF-style rounded type, and iOS-native switches, dialogs, tab bar and rail.\\\",\\n  \\\"main\\\": \\\"src/main.tsx\\\",\\n  \\\"icon\\\": \\\"icon.svg\\\",\\n  \\\"permissions\\\": [\\\"ui\\\", \\\"storage\\\"]\\n}\\n\",\n      \"src/IosDialog.tsx\": \"import { Show } from \\\"solid-js\\\";\\n\\n// iOS alert dialog: a centered card with large continuous-corner radius\\n// (squircle ~ 21px), a blue \\\"OK\\\"/dismiss button and iOS system blur backdrop.\\n// Unlike the app's default bottom sheet, iOS dialogs are always centered and\\n// fairly small.\\n\\nexport function IosDialog(props: {\\n  title: string;\\n  open: boolean;\\n  onOpenChange: (open: boolean) => void;\\n  children: any;\\n}) {\\n  return (\\n    <Show when={props.open}>\\n      <div\\n        style={{\\n          position: \\\"fixed\\\",\\n          inset: \\\"0\\\",\\n          zIndex: 50,\\n          display: \\\"flex\\\",\\n          alignItems: \\\"center\\\",\\n          justifyContent: \\\"center\\\",\\n          padding: \\\"24px\\\",\\n        }}\\n      >\\n        {/* Backdrop */}\\n        <div\\n          style={{\\n            position: \\\"absolute\\\",\\n            inset: \\\"0\\\",\\n            background: \\\"rgba(0,0,0,0.4)\\\",\\n            backdropFilter: \\\"blur(20px) saturate(180%)\\\",\\n            WebkitBackdropFilter: \\\"blur(20px) saturate(180%)\\\",\\n          }}\\n          onClick={() => props.onOpenChange(false)}\\n        />\\n\\n        {/* Alert card */}\\n        <div\\n          role=\\\"dialog\\\"\\n          aria-modal=\\\"true\\\"\\n          aria-label={props.title}\\n          style={{\\n            position: \\\"relative\\\",\\n            zIndex: 10,\\n            width: \\\"100%\\\",\\n            maxWidth: \\\"270px\\\",\\n            overflow: \\\"hidden\\\",\\n            background: \\\"var(--color-surface-raised, #f9f9f9)\\\",\\n            borderRadius: \\\"21px\\\",\\n            boxShadow: \\\"0 20px 60px -12px rgba(0,0,0,0.4)\\\",\\n          }}\\n        >\\n          <div style={{ padding: \\\"20px 16px 8px\\\", textAlign: \\\"center\\\" }}>\\n            <h2\\n              style={{\\n                margin: \\\"0 0 8px\\\",\\n                fontSize: \\\"17px\\\",\\n                fontWeight: 600,\\n                color: \\\"var(--color-ink, #000)\\\",\\n              }}\\n            >\\n              {props.title}\\n            </h2>\\n            <div style={{ fontSize: \\\"13px\\\", lineHeight: \\\"1.45\\\", color: \\\"var(--color-ink-muted, #3c3c43)\\\" }}>\\n              {props.children}\\n            </div>\\n          </div>\\n\\n          {/* Button row */}\\n          <div\\n            style={{\\n              display: \\\"flex\\\",\\n              marginTop: \\\"12px\\\",\\n              borderTop: \\\"1px solid var(--color-border, rgba(60,60,67,0.16))\\\",\\n            }}\\n          >\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => props.onOpenChange(false)}\\n              style={{\\n                flex: \\\"1\\\",\\n                padding: \\\"11px 0\\\",\\n                border: 0,\\n                background: \\\"transparent\\\",\\n                fontSize: \\\"17px\\\",\\n                fontWeight: 600,\\n                color: \\\"var(--color-accent, #007aff)\\\",\\n                cursor: \\\"pointer\\\",\\n                fontFamily: \\\"inherit\\\",\\n              }}\\n            >\\n              Done\\n            </button>\\n          </div>\\n        </div>\\n      </div>\\n    </Show>\\n  );\\n}\\n\",\n      \"src/IosRail.tsx\": \"import { For } from \\\"solid-js\\\";\\n\\n// iOS-style desktop sidebar rail: translucent, frosted, with squircle\\n// (continuous-corner) icon tiles instead of the app's circular ones.\\n\\nconst TABS = [\\n  { id: \\\"/\\\", label: \\\"Chats\\\", glyph: \\\"💬\\\", match: (p: string) => p === \\\"/\\\" || p.startsWith(\\\"/chat\\\") },\\n  { id: \\\"/settings\\\", label: \\\"Settings\\\", glyph: \\\"⚙️\\\", match: (p: string) => p.startsWith(\\\"/settings\\\") },\\n  { id: \\\"/profile\\\", label: \\\"Profile\\\", glyph: \\\"👤\\\", match: (p: string) => p.startsWith(\\\"/profile\\\") },\\n];\\n\\nexport function IosRail(props: {\\n  navigate: (to: string) => void;\\n  pathname: string;\\n}) {\\n  const activeTab = () => TABS.find((t) => t.match(props.pathname))?.id ?? null;\\n\\n  return (\\n    <nav\\n      aria-label=\\\"Primary\\\"\\n      style={{\\n        display: \\\"flex\\\",\\n        flexDirection: \\\"column\\\",\\n        alignItems: \\\"center\\\",\\n        gap: \\\"6px\\\",\\n        width: \\\"100%\\\",\\n        height: \\\"100%\\\",\\n        padding: \\\"12px 0\\\",\\n        background: \\\"transparent\\\",\\n      }}\\n    >\\n      <For each={TABS}>\\n        {(tab) => {\\n          const active = () => activeTab() === tab.id;\\n          return (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => props.navigate(tab.id)}\\n              aria-current={active() ? \\\"page\\\" : undefined}\\n              title={tab.label}\\n              style={{\\n                display: \\\"inline-flex\\\",\\n                alignItems: \\\"center\\\",\\n                justifyContent: \\\"center\\\",\\n                width: \\\"48px\\\",\\n                height: \\\"48px\\\",\\n                border: 0,\\n                borderRadius: \\\"28% / 28%\\\",\\n                background: active() ? \\\"rgba(0,122,255,0.14)\\\" : \\\"transparent\\\",\\n                color: active() ? \\\"var(--color-accent, #007aff)\\\" : \\\"var(--color-ink-muted, #6b6459)\\\",\\n                fontSize: \\\"20px\\\",\\n                cursor: \\\"pointer\\\",\\n                transition: \\\"background-color 0.2s ease, color 0.2s ease\\\",\\n              }}\\n            >\\n              {tab.glyph}\\n            </button>\\n          );\\n        }}\\n      </For>\\n    </nav>\\n  );\\n}\\n\",\n      \"src/IosSwitch.tsx\": \"import { Show } from \\\"solid-js\\\";\\n\\n// The iOS toggle: a green track (SF system green) with a white knob that\\n// slides. Slightly narrower than the built-in pill and with the iOS\\n// translucent border around the knob.\\n\\nexport function IosSwitch(props: {\\n  checked: boolean;\\n  onChange: (v: boolean) => void;\\n  label?: string;\\n}) {\\n  return (\\n    <button\\n      type=\\\"button\\\"\\n      role=\\\"switch\\\"\\n      aria-checked={props.checked}\\n      aria-label={props.label}\\n      onClick={() => props.onChange(!props.checked)}\\n      style={{\\n        position: \\\"relative\\\",\\n        display: \\\"inline-flex\\\",\\n        alignItems: \\\"center\\\",\\n        width: \\\"51px\\\",\\n        height: \\\"31px\\\",\\n        flexShrink: 0,\\n        padding: 0,\\n        border: 0,\\n        background: \\\"transparent\\\",\\n        cursor: \\\"pointer\\\",\\n      }}\\n    >\\n      <span\\n        style={{\\n          position: \\\"relative\\\",\\n          display: \\\"block\\\",\\n          width: \\\"51px\\\",\\n          height: \\\"31px\\\",\\n          borderRadius: \\\"999px\\\",\\n          background: props.checked ? \\\"#34c759\\\" : \\\"rgba(120,120,128,0.32)\\\",\\n          transition: \\\"background-color 0.2s ease\\\",\\n          boxShadow: props.checked\\n            ? \\\"inset 0 0 0 0.5px rgba(0,0,0,0.04)\\\"\\n            : \\\"inset 0 0 0 0.5px rgba(0,0,0,0.04)\\\",\\n        }}\\n      >\\n        <span\\n          style={{\\n            position: \\\"absolute\\\",\\n            top: \\\"2px\\\",\\n            left: props.checked ? \\\"24px\\\" : \\\"2px\\\",\\n            width: \\\"27px\\\",\\n            height: \\\"27px\\\",\\n            borderRadius: \\\"999px\\\",\\n            background: \\\"#ffffff\\\",\\n            boxShadow: \\\"0 3px 8px rgba(0,0,0,0.15), 0 1px 1px rgba(0,0,0,0.16)\\\",\\n            transition: \\\"left 0.2s ease\\\",\\n          }}\\n        />\\n      </span>\\n    </button>\\n  );\\n}\\n\",\n      \"src/IosTabBar.tsx\": \"import { For } from \\\"solid-js\\\";\\n\\n// iOS tab bar: a translucent frosted bar docked to the bottom edge, with\\n// centered icon + label per tab, the active tab in system blue. Uses SF\\n// Symbol-ish glyphs (we can't ship the SF font, so these are simple unicode\\n// approximations) and the app's safe-area inset for the home indicator.\\n\\nconst TABS = [\\n  { id: \\\"/\\\", label: \\\"Chats\\\", glyph: \\\"💬\\\", match: (p: string) => p === \\\"/\\\" || p.startsWith(\\\"/chat\\\") },\\n  { id: \\\"/settings\\\", label: \\\"Settings\\\", glyph: \\\"⚙️\\\", match: (p: string) => p.startsWith(\\\"/settings\\\") },\\n  { id: \\\"/profile\\\", label: \\\"Profile\\\", glyph: \\\"👤\\\", match: (p: string) => p.startsWith(\\\"/profile\\\") },\\n];\\n\\nexport function IosTabBar(props: {\\n  navigate: (to: string) => void;\\n  pathname: string;\\n}) {\\n  const activeTab = () => TABS.find((t) => t.match(props.pathname))?.id ?? null;\\n\\n  return (\\n    <div\\n      role=\\\"navigation\\\"\\n      aria-label=\\\"Primary\\\"\\n      style={{\\n        position: \\\"fixed\\\",\\n        inset: \\\"auto 0 0 0\\\",\\n        zIndex: 30,\\n        display: \\\"flex\\\",\\n        alignItems: \\\"stretch\\\",\\n        background: \\\"rgba(246,246,246,0.78)\\\",\\n        backdropFilter: \\\"blur(20px) saturate(180%)\\\",\\n        WebkitBackdropFilter: \\\"blur(20px) saturate(180%)\\\",\\n        borderTop: \\\"0.5px solid rgba(0,0,0,0.12)\\\",\\n        paddingTop: \\\"8px\\\",\\n        paddingBottom: \\\"max(var(--safe-bottom, 0px), 0px)\\\",\\n        boxShadow: \\\"0 -0.5px 0 rgba(0,0,0,0.02)\\\",\\n      }}\\n    >\\n      <For each={TABS}>\\n        {(tab) => {\\n          const active = () => activeTab() === tab.id;\\n          return (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => props.navigate(tab.id)}\\n              aria-current={active() ? \\\"page\\\" : undefined}\\n              style={{\\n                flex: 1,\\n                display: \\\"flex\\\",\\n                flexDirection: \\\"column\\\",\\n                alignItems: \\\"center\\\",\\n                justifyContent: \\\"center\\\",\\n                gap: \\\"3px\\\",\\n                padding: \\\"4px 0 6px\\\",\\n                border: 0,\\n                background: \\\"transparent\\\",\\n                cursor: \\\"pointer\\\",\\n                fontFamily: \\\"inherit\\\",\\n              }}\\n            >\\n              <span\\n                style={{\\n                  display: \\\"inline-flex\\\",\\n                  alignItems: \\\"center\\\",\\n                  justifyContent: \\\"center\\\",\\n                  width: \\\"44px\\\",\\n                  height: \\\"29px\\\",\\n                  borderRadius: \\\"999px\\\",\\n                  background: active() ? \\\"rgba(0,122,255,0.14)\\\" : \\\"transparent\\\",\\n                  color: active() ? \\\"var(--color-accent, #007aff)\\\" : \\\"var(--color-ink-muted, #6b6459)\\\",\\n                  fontSize: \\\"18px\\\",\\n                  transition: \\\"background-color 0.2s ease, color 0.2s ease\\\",\\n                }}\\n              >\\n                {tab.glyph}\\n              </span>\\n              <span\\n                style={{\\n                  fontSize: \\\"10px\\\",\\n                  fontWeight: active() ? 600 : 500,\\n                  color: active() ? \\\"var(--color-accent, #007aff)\\\" : \\\"var(--color-ink-muted, #6b6459)\\\",\\n                }}\\n              >\\n                {tab.label}\\n              </span>\\n            </button>\\n          );\\n        }}\\n      </For>\\n    </div>\\n  );\\n}\\n\",\n      \"src/Settings.tsx\": \"import { createSignal } from \\\"solid-js\\\";\\n\\n// iOSify configuration screen — toggles which parts of the iOS treatment the\\n// plugin applies. Settings persist in the plugin's own storage.\\n\\nconst FEATURES = [\\n  { key: \\\"colors\\\", label: \\\"iOS colors\\\", hint: \\\"System blue accent, iOS grays\\\" },\\n  { key: \\\"gradient\\\", label: \\\"Gradient background\\\", hint: \\\"Liquid-glass gradient wallpaper\\\" },\\n  { key: \\\"squircles\\\", label: \\\"Squircles\\\", hint: \\\"Continuous-corner avatars & cards\\\" },\\n  { key: \\\"nofont\\\", label: \\\"SF-style font\\\", hint: \\\"System font stack\\\" },\\n  { key: \\\"nodesc\\\", label: \\\"No list descriptions\\\", hint: \\\"Grouped lists show one line\\\" },\\n  { key: \\\"iosui\\\", label: \\\"iOS components\\\", hint: \\\"Switch, dialog, tab bar, rail\\\" },\\n];\\n\\nexport function IosifySettings(props: {\\n  plugin: { id: string; name: string };\\n  onClose: () => void;\\n  ctx: { storage: { get(key: string): string | null; set(key: string, value: string): void } };\\n}) {\\n  const read = (key: string, def = true) => {\\n    const v = props.ctx.storage.get(key);\\n    return v === null ? def : v === \\\"1\\\";\\n  };\\n\\n  const [toggles, setToggles] = createSignal<Record<string, boolean>>(\\n    Object.fromEntries(FEATURES.map((f) => [f.key, read(f.key)])),\\n  );\\n\\n  const set = (key: string, on: boolean) => {\\n    setToggles({ ...toggles(), [key]: on });\\n    props.ctx.storage.set(key, on ? \\\"1\\\" : \\\"0\\\");\\n  };\\n\\n  return (\\n    <div style={{ display: \\\"flex\\\", \\\"flex-direction\\\": \\\"column\\\", gap: \\\"12px\\\" }}>\\n      <p style={{ margin: \\\"0\\\", \\\"font-size\\\": \\\"13px\\\", color: \\\"var(--color-ink-subtle)\\\" }}>\\n        Makes the app look like iOS. Toggle each treatment on or off.\\n      </p>\\n\\n      <div style={{ display: \\\"flex\\\", \\\"flex-direction\\\": \\\"column\\\", gap: \\\"4px\\\" }}>\\n        {FEATURES.map((f) => (\\n          <div\\n            key={f.key}\\n            style={{\\n              display: \\\"flex\\\",\\n              \\\"align-items\\\": \\\"center\\\",\\n              \\\"justify-content\\\": \\\"space-between\\\",\\n              gap: \\\"12px\\\",\\n              padding: \\\"10px 4px\\\",\\n              \\\"border-bottom\\\": \\\"1px solid var(--color-border)\\\",\\n            }}\\n          >\\n            <div style={{ \\\"min-width\\\": \\\"0\\\" }}>\\n              <p style={{ margin: \\\"0\\\", \\\"font-size\\\": \\\"14px\\\", \\\"font-weight\\\": 500, color: \\\"var(--color-ink)\\\" }}>\\n                {f.label}\\n              </p>\\n              <p style={{ margin: \\\"2px 0 0\\\", \\\"font-size\\\": \\\"12px\\\", color: \\\"var(--color-ink-subtle)\\\" }}>\\n                {f.hint}\\n              </p>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              role=\\\"switch\\\"\\n              aria-checked={toggles()[f.key]}\\n              onClick={() => set(f.key, !toggles()[f.key])}\\n              style={{\\n                flexShrink: 0,\\n                position: \\\"relative\\\",\\n                width: \\\"51px\\\",\\n                height: \\\"31px\\\",\\n                border: 0,\\n                padding: 0,\\n                borderRadius: \\\"999px\\\",\\n                background: toggles()[f.key] ? \\\"#34c759\\\" : \\\"rgba(120,120,128,0.32)\\\",\\n                cursor: \\\"pointer\\\",\\n                transition: \\\"background-color 0.2s ease\\\",\\n              }}\\n            >\\n              <span\\n                style={{\\n                  position: \\\"absolute\\\",\\n                  top: \\\"2px\\\",\\n                  left: toggles()[f.key] ? \\\"24px\\\" : \\\"2px\\\",\\n                  width: \\\"27px\\\",\\n                  height: \\\"27px\\\",\\n                  borderRadius: \\\"999px\\\",\\n                  background: \\\"#fff\\\",\\n                  boxShadow: \\\"0 3px 8px rgba(0,0,0,0.15)\\\",\\n                  transition: \\\"left 0.2s ease\\\",\\n                }}\\n              />\\n            </button>\\n          </div>\\n        ))}\\n      </div>\\n\\n      <button\\n        type=\\\"button\\\"\\n        onClick={props.onClose}\\n        style={{\\n          padding: \\\"10px 0\\\",\\n          border: 0,\\n          borderRadius: \\\"14px\\\",\\n          background: \\\"var(--color-accent-soft)\\\",\\n          color: \\\"var(--color-accent)\\\",\\n          \\\"font-size\\\": \\\"15px\\\",\\n          \\\"font-weight\\\": 600,\\n          cursor: \\\"pointer\\\",\\n          fontFamily: \\\"inherit\\\",\\n        }}\\n      >\\n        Done\\n      </button>\\n    </div>\\n  );\\n}\\n\",\n      \"src/main.tsx\": \"import { IosSwitch } from \\\"./IosSwitch\\\";\\nimport { IosDialog } from \\\"./IosDialog\\\";\\nimport { IosTabBar } from \\\"./IosTabBar\\\";\\nimport { IosRail } from \\\"./IosRail\\\";\\nimport { IosifySettings } from \\\"./Settings\\\";\\nimport themeCss from \\\"./theme.css?raw\\\";\\n\\n// Atlas plugin — restyles the whole app to look like iOS: system colors,\\n// liquid-glass gradient wallpaper, squircle avatars/cards, SF-style type,\\n// grouped lists without descriptions, and iOS-native switch/dialog/nav.\\n//\\n// Unlike the other example plugins, this one also injects a global <style>\\n// sheet (theme.css) so it can restyle parts of the app it doesn't own via CSS\\n// custom properties and a few targeted rules.\\n\\nexport function activate(ctx) {\\n  ctx.log(\\\"iOSify active\\\");\\n\\n  const read = (key: string, def = true) => {\\n    const v = ctx.storage.get(key);\\n    return v === null ? def : v === \\\"1\\\";\\n  };\\n\\n  // Inject the theme stylesheet. Split the rules into blocks so the config\\n  // toggles can strip specific sections without re-injecting the whole file.\\n  const STYLE_ID = \\\"atlas-iosify-theme\\\";\\n  let styleEl: HTMLStyleElement | null = null;\\n\\n  const inject = () => {\\n    if (!styleEl) {\\n      styleEl = document.createElement(\\\"style\\\");\\n      styleEl.id = STYLE_ID;\\n      document.head.appendChild(styleEl);\\n    }\\n    const parts: string[] = [];\\n    if (read(\\\"colors\\\")) parts.push(\\\"COLORS\\\");\\n    if (read(\\\"gradient\\\")) parts.push(\\\"GRADIENT\\\");\\n    if (read(\\\"squircles\\\")) parts.push(\\\"SQUIRCLES\\\");\\n    if (read(\\\"nofont\\\")) parts.push(\\\"FONT\\\");\\n    if (read(\\\"nodesc\\\")) parts.push(\\\"NODESC\\\");\\n    styleEl.textContent = buildCss(parts);\\n  };\\n\\n  // Wait for Solid to render the app root before mounting UI slots, so the\\n  // app's own shells (BottomNav/SideNav/Dialog/Switch) pick up our slots.\\n  const applyTheme = () => {\\n    inject();\\n    if (read(\\\"iosui\\\")) {\\n      ctx.ui.mount(\\\"switch\\\", (props) => (\\n        <IosSwitch checked={props.checked} onChange={props.onChange} label={props.label} />\\n      ));\\n      ctx.ui.mount(\\\"dialog\\\", (props) => (\\n        <IosDialog title={props.title} open={props.open} onOpenChange={props.onOpenChange}>\\n          {props.children}\\n        </IosDialog>\\n      ));\\n      ctx.ui.mount(\\\"nav.bottom\\\", (props) => (\\n        <IosTabBar navigate={props.navigate} pathname={props.pathname} />\\n      ));\\n      ctx.ui.mount(\\\"nav.side\\\", (props) => (\\n        <IosRail navigate={props.navigate} pathname={props.pathname} />\\n      ));\\n    }\\n  };\\n\\n  applyTheme();\\n\\n  ctx.ui.configScreen(({ plugin, onClose }) => (\\n    <IosifySettings plugin={plugin} onClose={onClose} ctx={ctx} />\\n  ));\\n}\\n\\nfunction buildCss(parts: string[]): string {\\n  const all = (key: string) => parts.includes(key);\\n\\n  const css: string[] = [];\\n\\n  if (all(\\\"COLORS\\\")) {\\n    css.push(`\\n:root {\\n  --color-accent: #007aff;\\n  --color-accent-soft: #e3f0ff;\\n  --color-accent-ink: #ffffff;\\n  --color-bg: #f2f2f7;\\n  --color-surface: #ffffff;\\n  --color-surface-raised: #ffffff;\\n  --color-border: rgba(60, 60, 67, 0.16);\\n  --color-appbar: rgba(249, 249, 249, 0.86);\\n  --color-ink: #000000;\\n  --color-ink-muted: #3c3c43;\\n  --color-ink-subtle: #6c6c70;\\n  --color-danger: #ff3b30;\\n  --color-bubble-sent: #007aff;\\n  --color-bubble-sent-ink: #ffffff;\\n  --color-bubble-received: #e9e9eb;\\n  --color-bubble-received-ink: #000000;\\n}\\n:root[data-theme=\\\"dark\\\"] {\\n  --color-accent: #0a84ff;\\n  --color-accent-soft: #12345c;\\n  --color-accent-ink: #ffffff;\\n  --color-bg: #000000;\\n  --color-surface: #1c1c1e;\\n  --color-surface-raised: #2c2c2e;\\n  --color-border: rgba(84, 84, 88, 0.5);\\n  --color-appbar: rgba(22, 22, 24, 0.82);\\n  --color-ink: #ffffff;\\n  --color-ink-muted: #98989f;\\n  --color-ink-subtle: #636366;\\n  --color-danger: #ff453a;\\n  --color-bubble-sent: #0a84ff;\\n  --color-bubble-received: #262628;\\n  --color-bubble-received-ink: #ffffff;\\n}\\n`);\\n  }\\n\\n  if (all(\\\"GRADIENT\\\")) {\\n    css.push(`\\nbody, #root { background: transparent !important; }\\n#root { position: relative; }\\n#root::before {\\n  content: \\\"\\\";\\n  position: fixed;\\n  inset: 0;\\n  z-index: -1;\\n  background:\\n    radial-gradient(120% 90% at 15% 0%, rgba(0, 122, 255, 0.35) 0%, transparent 55%),\\n    radial-gradient(120% 90% at 100% 10%, rgba(175, 82, 222, 0.22) 0%, transparent 60%),\\n    radial-gradient(140% 120% at 50% 110%, rgba(0, 199, 190, 0.28) 0%, transparent 60%),\\n    var(--color-bg);\\n  pointer-events: none;\\n}\\n:root[data-theme=\\\"dark\\\"] #root::before {\\n  background:\\n    radial-gradient(120% 90% at 15% 0%, rgba(10, 132, 255, 0.45) 0%, transparent 55%),\\n    radial-gradient(120% 90% at 100% 10%, rgba(191, 90, 242, 0.3) 0%, transparent 60%),\\n    radial-gradient(140% 120% at 50% 110%, rgba(64, 200, 224, 0.25) 0%, transparent 60%),\\n    var(--color-bg);\\n}\\n`);\\n  }\\n\\n  if (all(\\\"SQUIRCLES\\\")) {\\n    css.push(`\\nimg.rounded-full,\\ndiv[style*=\\\"background-color\\\"][class*=\\\"rounded-full\\\"] {\\n  border-radius: 28% / 28% !important;\\n}\\n.h-3.w-3, .h-1\\\\\\\\.5.w-1\\\\\\\\.5, .h-5.min-w-5 {\\n  border-radius: 9999px !important;\\n}\\n.rounded-2xl { border-radius: 12px !important; }\\n.rounded-3xl { border-radius: 16px !important; }\\n`);\\n  }\\n\\n  if (all(\\\"FONT\\\")) {\\n    css.push(`\\n:root {\\n  --font-sans: -apple-system, BlinkMacSystemFont, \\\"SF Pro Text\\\", \\\"SF Pro Display\\\", \\\"Segoe UI\\\", system-ui, sans-serif;\\n  --font-heading: -apple-system, BlinkMacSystemFont, \\\"SF Pro Display\\\", \\\"Segoe UI\\\", system-ui, sans-serif;\\n  --font-size-base: 17px;\\n}\\n`);\\n  }\\n\\n  if (all(\\\"NODESC\\\")) {\\n    css.push(`\\n.divide-y p.text-ink-subtle { display: none; }\\n`);\\n  }\\n\\n  return css.join(\\\"\\\\n\\\");\\n}\\n\"\n    },\n    \"enabled\": true\n  }\n}",
      "icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"5\"/><path d=\"M7 9h10M7 13h10\"/></svg>\n",
      "manifest.json": "{\n  \"id\": \"dev.iosify\",\n  \"name\": \"iOSify\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Restyles the whole app like iOS: system-blue accent, liquid-glass gradients, squircle avatars and controls (not circles), inset grouped lists without descriptions, SF-style rounded type, and iOS-native switches, dialogs, tab bar and rail.\",\n  \"main\": \"src/main.tsx\",\n  \"icon\": \"icon.svg\",\n  \"permissions\": [\"ui\", \"storage\"]\n}\n",
      "src/IosDialog.tsx": "import { Show } from \"solid-js\";\n\n// iOS alert dialog: a centered card with large continuous-corner radius\n// (squircle ~ 21px), a blue \"OK\"/dismiss button and iOS system blur backdrop.\n// Unlike the app's default bottom sheet, iOS dialogs are always centered and\n// fairly small.\n\nexport function IosDialog(props: {\n  title: string;\n  open: boolean;\n  onOpenChange: (open: boolean) => void;\n  children: any;\n}) {\n  return (\n    <Show when={props.open}>\n      <div\n        style={{\n          position: \"fixed\",\n          inset: \"0\",\n          zIndex: 50,\n          display: \"flex\",\n          alignItems: \"center\",\n          justifyContent: \"center\",\n          padding: \"24px\",\n        }}\n      >\n        {/* Backdrop */}\n        <div\n          style={{\n            position: \"absolute\",\n            inset: \"0\",\n            background: \"rgba(0,0,0,0.4)\",\n            backdropFilter: \"blur(20px) saturate(180%)\",\n            WebkitBackdropFilter: \"blur(20px) saturate(180%)\",\n          }}\n          onClick={() => props.onOpenChange(false)}\n        />\n\n        {/* Alert card */}\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-label={props.title}\n          style={{\n            position: \"relative\",\n            zIndex: 10,\n            width: \"100%\",\n            maxWidth: \"270px\",\n            overflow: \"hidden\",\n            background: \"var(--color-surface-raised, #f9f9f9)\",\n            borderRadius: \"21px\",\n            boxShadow: \"0 20px 60px -12px rgba(0,0,0,0.4)\",\n          }}\n        >\n          <div style={{ padding: \"20px 16px 8px\", textAlign: \"center\" }}>\n            <h2\n              style={{\n                margin: \"0 0 8px\",\n                fontSize: \"17px\",\n                fontWeight: 600,\n                color: \"var(--color-ink, #000)\",\n              }}\n            >\n              {props.title}\n            </h2>\n            <div style={{ fontSize: \"13px\", lineHeight: \"1.45\", color: \"var(--color-ink-muted, #3c3c43)\" }}>\n              {props.children}\n            </div>\n          </div>\n\n          {/* Button row */}\n          <div\n            style={{\n              display: \"flex\",\n              marginTop: \"12px\",\n              borderTop: \"1px solid var(--color-border, rgba(60,60,67,0.16))\",\n            }}\n          >\n            <button\n              type=\"button\"\n              onClick={() => props.onOpenChange(false)}\n              style={{\n                flex: \"1\",\n                padding: \"11px 0\",\n                border: 0,\n                background: \"transparent\",\n                fontSize: \"17px\",\n                fontWeight: 600,\n                color: \"var(--color-accent, #007aff)\",\n                cursor: \"pointer\",\n                fontFamily: \"inherit\",\n              }}\n            >\n              Done\n            </button>\n          </div>\n        </div>\n      </div>\n    </Show>\n  );\n}\n",
      "src/IosRail.tsx": "import { For } from \"solid-js\";\n\n// iOS-style desktop sidebar rail: translucent, frosted, with squircle\n// (continuous-corner) icon tiles instead of the app's circular ones.\n\nconst TABS = [\n  { id: \"/\", label: \"Chats\", glyph: \"💬\", match: (p: string) => p === \"/\" || p.startsWith(\"/chat\") },\n  { id: \"/settings\", label: \"Settings\", glyph: \"⚙️\", match: (p: string) => p.startsWith(\"/settings\") },\n  { id: \"/profile\", label: \"Profile\", glyph: \"👤\", match: (p: string) => p.startsWith(\"/profile\") },\n];\n\nexport function IosRail(props: {\n  navigate: (to: string) => void;\n  pathname: string;\n}) {\n  const activeTab = () => TABS.find((t) => t.match(props.pathname))?.id ?? null;\n\n  return (\n    <nav\n      aria-label=\"Primary\"\n      style={{\n        display: \"flex\",\n        flexDirection: \"column\",\n        alignItems: \"center\",\n        gap: \"6px\",\n        width: \"100%\",\n        height: \"100%\",\n        padding: \"12px 0\",\n        background: \"transparent\",\n      }}\n    >\n      <For each={TABS}>\n        {(tab) => {\n          const active = () => activeTab() === tab.id;\n          return (\n            <button\n              type=\"button\"\n              onClick={() => props.navigate(tab.id)}\n              aria-current={active() ? \"page\" : undefined}\n              title={tab.label}\n              style={{\n                display: \"inline-flex\",\n                alignItems: \"center\",\n                justifyContent: \"center\",\n                width: \"48px\",\n                height: \"48px\",\n                border: 0,\n                borderRadius: \"28% / 28%\",\n                background: active() ? \"rgba(0,122,255,0.14)\" : \"transparent\",\n                color: active() ? \"var(--color-accent, #007aff)\" : \"var(--color-ink-muted, #6b6459)\",\n                fontSize: \"20px\",\n                cursor: \"pointer\",\n                transition: \"background-color 0.2s ease, color 0.2s ease\",\n              }}\n            >\n              {tab.glyph}\n            </button>\n          );\n        }}\n      </For>\n    </nav>\n  );\n}\n",
      "src/IosSwitch.tsx": "import { Show } from \"solid-js\";\n\n// The iOS toggle: a green track (SF system green) with a white knob that\n// slides. Slightly narrower than the built-in pill and with the iOS\n// translucent border around the knob.\n\nexport function IosSwitch(props: {\n  checked: boolean;\n  onChange: (v: boolean) => void;\n  label?: string;\n}) {\n  return (\n    <button\n      type=\"button\"\n      role=\"switch\"\n      aria-checked={props.checked}\n      aria-label={props.label}\n      onClick={() => props.onChange(!props.checked)}\n      style={{\n        position: \"relative\",\n        display: \"inline-flex\",\n        alignItems: \"center\",\n        width: \"51px\",\n        height: \"31px\",\n        flexShrink: 0,\n        padding: 0,\n        border: 0,\n        background: \"transparent\",\n        cursor: \"pointer\",\n      }}\n    >\n      <span\n        style={{\n          position: \"relative\",\n          display: \"block\",\n          width: \"51px\",\n          height: \"31px\",\n          borderRadius: \"999px\",\n          background: props.checked ? \"#34c759\" : \"rgba(120,120,128,0.32)\",\n          transition: \"background-color 0.2s ease\",\n          boxShadow: props.checked\n            ? \"inset 0 0 0 0.5px rgba(0,0,0,0.04)\"\n            : \"inset 0 0 0 0.5px rgba(0,0,0,0.04)\",\n        }}\n      >\n        <span\n          style={{\n            position: \"absolute\",\n            top: \"2px\",\n            left: props.checked ? \"24px\" : \"2px\",\n            width: \"27px\",\n            height: \"27px\",\n            borderRadius: \"999px\",\n            background: \"#ffffff\",\n            boxShadow: \"0 3px 8px rgba(0,0,0,0.15), 0 1px 1px rgba(0,0,0,0.16)\",\n            transition: \"left 0.2s ease\",\n          }}\n        />\n      </span>\n    </button>\n  );\n}\n",
      "src/IosTabBar.tsx": "import { For } from \"solid-js\";\n\n// iOS tab bar: a translucent frosted bar docked to the bottom edge, with\n// centered icon + label per tab, the active tab in system blue. Uses SF\n// Symbol-ish glyphs (we can't ship the SF font, so these are simple unicode\n// approximations) and the app's safe-area inset for the home indicator.\n\nconst TABS = [\n  { id: \"/\", label: \"Chats\", glyph: \"💬\", match: (p: string) => p === \"/\" || p.startsWith(\"/chat\") },\n  { id: \"/settings\", label: \"Settings\", glyph: \"⚙️\", match: (p: string) => p.startsWith(\"/settings\") },\n  { id: \"/profile\", label: \"Profile\", glyph: \"👤\", match: (p: string) => p.startsWith(\"/profile\") },\n];\n\nexport function IosTabBar(props: {\n  navigate: (to: string) => void;\n  pathname: string;\n}) {\n  const activeTab = () => TABS.find((t) => t.match(props.pathname))?.id ?? null;\n\n  return (\n    <div\n      role=\"navigation\"\n      aria-label=\"Primary\"\n      style={{\n        position: \"fixed\",\n        inset: \"auto 0 0 0\",\n        zIndex: 30,\n        display: \"flex\",\n        alignItems: \"stretch\",\n        background: \"rgba(246,246,246,0.78)\",\n        backdropFilter: \"blur(20px) saturate(180%)\",\n        WebkitBackdropFilter: \"blur(20px) saturate(180%)\",\n        borderTop: \"0.5px solid rgba(0,0,0,0.12)\",\n        paddingTop: \"8px\",\n        paddingBottom: \"max(var(--safe-bottom, 0px), 0px)\",\n        boxShadow: \"0 -0.5px 0 rgba(0,0,0,0.02)\",\n      }}\n    >\n      <For each={TABS}>\n        {(tab) => {\n          const active = () => activeTab() === tab.id;\n          return (\n            <button\n              type=\"button\"\n              onClick={() => props.navigate(tab.id)}\n              aria-current={active() ? \"page\" : undefined}\n              style={{\n                flex: 1,\n                display: \"flex\",\n                flexDirection: \"column\",\n                alignItems: \"center\",\n                justifyContent: \"center\",\n                gap: \"3px\",\n                padding: \"4px 0 6px\",\n                border: 0,\n                background: \"transparent\",\n                cursor: \"pointer\",\n                fontFamily: \"inherit\",\n              }}\n            >\n              <span\n                style={{\n                  display: \"inline-flex\",\n                  alignItems: \"center\",\n                  justifyContent: \"center\",\n                  width: \"44px\",\n                  height: \"29px\",\n                  borderRadius: \"999px\",\n                  background: active() ? \"rgba(0,122,255,0.14)\" : \"transparent\",\n                  color: active() ? \"var(--color-accent, #007aff)\" : \"var(--color-ink-muted, #6b6459)\",\n                  fontSize: \"18px\",\n                  transition: \"background-color 0.2s ease, color 0.2s ease\",\n                }}\n              >\n                {tab.glyph}\n              </span>\n              <span\n                style={{\n                  fontSize: \"10px\",\n                  fontWeight: active() ? 600 : 500,\n                  color: active() ? \"var(--color-accent, #007aff)\" : \"var(--color-ink-muted, #6b6459)\",\n                }}\n              >\n                {tab.label}\n              </span>\n            </button>\n          );\n        }}\n      </For>\n    </div>\n  );\n}\n",
      "src/Settings.tsx": "import { createSignal } from \"solid-js\";\n\n// iOSify configuration screen — toggles which parts of the iOS treatment the\n// plugin applies. Settings persist in the plugin's own storage.\n\nconst FEATURES = [\n  { key: \"colors\", label: \"iOS colors\", hint: \"System blue accent, iOS grays\" },\n  { key: \"gradient\", label: \"Gradient background\", hint: \"Liquid-glass gradient wallpaper\" },\n  { key: \"squircles\", label: \"Squircles\", hint: \"Continuous-corner avatars & cards\" },\n  { key: \"nofont\", label: \"SF-style font\", hint: \"System font stack\" },\n  { key: \"nodesc\", label: \"No list descriptions\", hint: \"Grouped lists show one line\" },\n  { key: \"iosui\", label: \"iOS components\", hint: \"Switch, dialog, tab bar, rail\" },\n];\n\nexport function IosifySettings(props: {\n  plugin: { id: string; name: string };\n  onClose: () => void;\n  ctx: { storage: { get(key: string): string | null; set(key: string, value: string): void } };\n}) {\n  const read = (key: string, def = true) => {\n    const v = props.ctx.storage.get(key);\n    return v === null ? def : v === \"1\";\n  };\n\n  const [toggles, setToggles] = createSignal<Record<string, boolean>>(\n    Object.fromEntries(FEATURES.map((f) => [f.key, read(f.key)])),\n  );\n\n  const set = (key: string, on: boolean) => {\n    setToggles({ ...toggles(), [key]: on });\n    props.ctx.storage.set(key, on ? \"1\" : \"0\");\n  };\n\n  return (\n    <div style={{ display: \"flex\", \"flex-direction\": \"column\", gap: \"12px\" }}>\n      <p style={{ margin: \"0\", \"font-size\": \"13px\", color: \"var(--color-ink-subtle)\" }}>\n        Makes the app look like iOS. Toggle each treatment on or off.\n      </p>\n\n      <div style={{ display: \"flex\", \"flex-direction\": \"column\", gap: \"4px\" }}>\n        {FEATURES.map((f) => (\n          <div\n            key={f.key}\n            style={{\n              display: \"flex\",\n              \"align-items\": \"center\",\n              \"justify-content\": \"space-between\",\n              gap: \"12px\",\n              padding: \"10px 4px\",\n              \"border-bottom\": \"1px solid var(--color-border)\",\n            }}\n          >\n            <div style={{ \"min-width\": \"0\" }}>\n              <p style={{ margin: \"0\", \"font-size\": \"14px\", \"font-weight\": 500, color: \"var(--color-ink)\" }}>\n                {f.label}\n              </p>\n              <p style={{ margin: \"2px 0 0\", \"font-size\": \"12px\", color: \"var(--color-ink-subtle)\" }}>\n                {f.hint}\n              </p>\n            </div>\n            <button\n              type=\"button\"\n              role=\"switch\"\n              aria-checked={toggles()[f.key]}\n              onClick={() => set(f.key, !toggles()[f.key])}\n              style={{\n                flexShrink: 0,\n                position: \"relative\",\n                width: \"51px\",\n                height: \"31px\",\n                border: 0,\n                padding: 0,\n                borderRadius: \"999px\",\n                background: toggles()[f.key] ? \"#34c759\" : \"rgba(120,120,128,0.32)\",\n                cursor: \"pointer\",\n                transition: \"background-color 0.2s ease\",\n              }}\n            >\n              <span\n                style={{\n                  position: \"absolute\",\n                  top: \"2px\",\n                  left: toggles()[f.key] ? \"24px\" : \"2px\",\n                  width: \"27px\",\n                  height: \"27px\",\n                  borderRadius: \"999px\",\n                  background: \"#fff\",\n                  boxShadow: \"0 3px 8px rgba(0,0,0,0.15)\",\n                  transition: \"left 0.2s ease\",\n                }}\n              />\n            </button>\n          </div>\n        ))}\n      </div>\n\n      <button\n        type=\"button\"\n        onClick={props.onClose}\n        style={{\n          padding: \"10px 0\",\n          border: 0,\n          borderRadius: \"14px\",\n          background: \"var(--color-accent-soft)\",\n          color: \"var(--color-accent)\",\n          \"font-size\": \"15px\",\n          \"font-weight\": 600,\n          cursor: \"pointer\",\n          fontFamily: \"inherit\",\n        }}\n      >\n        Done\n      </button>\n    </div>\n  );\n}\n",
      "src/main.tsx": "import { IosSwitch } from \"./IosSwitch\";\nimport { IosDialog } from \"./IosDialog\";\nimport { IosTabBar } from \"./IosTabBar\";\nimport { IosRail } from \"./IosRail\";\nimport { IosifySettings } from \"./Settings\";\nimport themeCss from \"./theme.css?raw\";\n\n// Atlas plugin — restyles the whole app to look like iOS: system colors,\n// liquid-glass gradient wallpaper, squircle avatars/cards, SF-style type,\n// grouped lists without descriptions, and iOS-native switch/dialog/nav.\n//\n// Unlike the other example plugins, this one also injects a global <style>\n// sheet (theme.css) so it can restyle parts of the app it doesn't own via CSS\n// custom properties and a few targeted rules.\n\nexport function activate(ctx) {\n  ctx.log(\"iOSify active\");\n\n  const read = (key: string, def = true) => {\n    const v = ctx.storage.get(key);\n    return v === null ? def : v === \"1\";\n  };\n\n  // Inject the theme stylesheet. Split the rules into blocks so the config\n  // toggles can strip specific sections without re-injecting the whole file.\n  const STYLE_ID = \"atlas-iosify-theme\";\n  let styleEl: HTMLStyleElement | null = null;\n\n  const inject = () => {\n    if (!styleEl) {\n      styleEl = document.createElement(\"style\");\n      styleEl.id = STYLE_ID;\n      document.head.appendChild(styleEl);\n    }\n    const parts: string[] = [];\n    if (read(\"colors\")) parts.push(\"COLORS\");\n    if (read(\"gradient\")) parts.push(\"GRADIENT\");\n    if (read(\"squircles\")) parts.push(\"SQUIRCLES\");\n    if (read(\"nofont\")) parts.push(\"FONT\");\n    if (read(\"nodesc\")) parts.push(\"NODESC\");\n    styleEl.textContent = buildCss(parts);\n  };\n\n  // Wait for Solid to render the app root before mounting UI slots, so the\n  // app's own shells (BottomNav/SideNav/Dialog/Switch) pick up our slots.\n  const applyTheme = () => {\n    inject();\n    if (read(\"iosui\")) {\n      ctx.ui.mount(\"switch\", (props) => (\n        <IosSwitch checked={props.checked} onChange={props.onChange} label={props.label} />\n      ));\n      ctx.ui.mount(\"dialog\", (props) => (\n        <IosDialog title={props.title} open={props.open} onOpenChange={props.onOpenChange}>\n          {props.children}\n        </IosDialog>\n      ));\n      ctx.ui.mount(\"nav.bottom\", (props) => (\n        <IosTabBar navigate={props.navigate} pathname={props.pathname} />\n      ));\n      ctx.ui.mount(\"nav.side\", (props) => (\n        <IosRail navigate={props.navigate} pathname={props.pathname} />\n      ));\n    }\n  };\n\n  applyTheme();\n\n  ctx.ui.configScreen(({ plugin, onClose }) => (\n    <IosifySettings plugin={plugin} onClose={onClose} ctx={ctx} />\n  ));\n}\n\nfunction buildCss(parts: string[]): string {\n  const all = (key: string) => parts.includes(key);\n\n  const css: string[] = [];\n\n  if (all(\"COLORS\")) {\n    css.push(`\n:root {\n  --color-accent: #007aff;\n  --color-accent-soft: #e3f0ff;\n  --color-accent-ink: #ffffff;\n  --color-bg: #f2f2f7;\n  --color-surface: #ffffff;\n  --color-surface-raised: #ffffff;\n  --color-border: rgba(60, 60, 67, 0.16);\n  --color-appbar: rgba(249, 249, 249, 0.86);\n  --color-ink: #000000;\n  --color-ink-muted: #3c3c43;\n  --color-ink-subtle: #6c6c70;\n  --color-danger: #ff3b30;\n  --color-bubble-sent: #007aff;\n  --color-bubble-sent-ink: #ffffff;\n  --color-bubble-received: #e9e9eb;\n  --color-bubble-received-ink: #000000;\n}\n:root[data-theme=\"dark\"] {\n  --color-accent: #0a84ff;\n  --color-accent-soft: #12345c;\n  --color-accent-ink: #ffffff;\n  --color-bg: #000000;\n  --color-surface: #1c1c1e;\n  --color-surface-raised: #2c2c2e;\n  --color-border: rgba(84, 84, 88, 0.5);\n  --color-appbar: rgba(22, 22, 24, 0.82);\n  --color-ink: #ffffff;\n  --color-ink-muted: #98989f;\n  --color-ink-subtle: #636366;\n  --color-danger: #ff453a;\n  --color-bubble-sent: #0a84ff;\n  --color-bubble-received: #262628;\n  --color-bubble-received-ink: #ffffff;\n}\n`);\n  }\n\n  if (all(\"GRADIENT\")) {\n    css.push(`\nbody, #root { background: transparent !important; }\n#root { position: relative; }\n#root::before {\n  content: \"\";\n  position: fixed;\n  inset: 0;\n  z-index: -1;\n  background:\n    radial-gradient(120% 90% at 15% 0%, rgba(0, 122, 255, 0.35) 0%, transparent 55%),\n    radial-gradient(120% 90% at 100% 10%, rgba(175, 82, 222, 0.22) 0%, transparent 60%),\n    radial-gradient(140% 120% at 50% 110%, rgba(0, 199, 190, 0.28) 0%, transparent 60%),\n    var(--color-bg);\n  pointer-events: none;\n}\n:root[data-theme=\"dark\"] #root::before {\n  background:\n    radial-gradient(120% 90% at 15% 0%, rgba(10, 132, 255, 0.45) 0%, transparent 55%),\n    radial-gradient(120% 90% at 100% 10%, rgba(191, 90, 242, 0.3) 0%, transparent 60%),\n    radial-gradient(140% 120% at 50% 110%, rgba(64, 200, 224, 0.25) 0%, transparent 60%),\n    var(--color-bg);\n}\n`);\n  }\n\n  if (all(\"SQUIRCLES\")) {\n    css.push(`\nimg.rounded-full,\ndiv[style*=\"background-color\"][class*=\"rounded-full\"] {\n  border-radius: 28% / 28% !important;\n}\n.h-3.w-3, .h-1\\\\.5.w-1\\\\.5, .h-5.min-w-5 {\n  border-radius: 9999px !important;\n}\n.rounded-2xl { border-radius: 12px !important; }\n.rounded-3xl { border-radius: 16px !important; }\n`);\n  }\n\n  if (all(\"FONT\")) {\n    css.push(`\n:root {\n  --font-sans: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"SF Pro Display\", \"Segoe UI\", system-ui, sans-serif;\n  --font-heading: -apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"Segoe UI\", system-ui, sans-serif;\n  --font-size-base: 17px;\n}\n`);\n  }\n\n  if (all(\"NODESC\")) {\n    css.push(`\n.divide-y p.text-ink-subtle { display: none; }\n`);\n  }\n\n  return css.join(\"\\n\");\n}\n"
    },
    "enabled": true
  }
}