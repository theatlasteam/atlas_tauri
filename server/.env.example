# Copy to .env for local development.
DATABASE_URL=postgres://atlas:atlas_dev_password@127.0.0.1:5432/atlas
BIND_ADDR=127.0.0.1:8080

# Days a login session lives without being revoked.
SESSION_TTL_DAYS=30

# Without a real TURN relay, calls only work when both sides are on the same
# LAN (or otherwise reachable P2P) — a phone on cellular and a desktop on a
# home network essentially always needs one. STUN alone (the default below)
# cannot fix this; it only ever helps find a direct path, and there frequently
# isn't one.
#
# Two ways to get a working TURN relay — pick one:
#
# 1. Fastest: a third-party TURN provider's fixed username/credential (skips
#    self-hosting entirely). Set TURN_URLS to include their turn: URLs and:
# TURN_STATIC_USERNAME=
# TURN_STATIC_CREDENTIAL=
#
# 2. Self-hosted: run coturn (turnserver.conf.example in this repo is ready to
#    use) on a small VPS with a public IPv4 and its UDP relay port range open —
#    Amvera's container platform can't do this itself. Then set TURN_SECRET to
#    match coturn's static-auth-secret; credentials are minted per-session
#    (see turn.rs), nothing fixed ships in the client.
TURN_SECRET=
# Comma-separated ICE URLs given to clients.
TURN_URLS=stun:stun.l.google.com:19302
# Self-hosted example:
# TURN_URLS=stun:turn.example.com:3478,turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp
TURN_TTL_SECS=3600

# Origins allowed for CORS. Unset (default) = allow any origin — safe here
# since auth is a Bearer token attached by client JS, never a cookie, so a
# third-party page has nothing to exploit via CORS regardless of this
# setting. Set explicitly only if you want to lock a production deployment
# down to known Tauri origins:
# CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost

# Android push notifications (FCM HTTP v1). The whole service-account JSON key
# from Firebase Console > Project Settings > Service accounts > Generate new
# private key — either raw JSON on one line, or base64 of the file if the
# hosting panel mangles multi-line values:
#   base64 -w0 atlas-firebase-adminsdk.json
# Unset (default) = push disabled and every notification is a no-op. A value
# that is set but unparseable aborts startup rather than silently disabling
# push. NOTE: this is the *application* service's variable — on Amvera it does
# not belong on the PostgreSQL service, whose env only configures the database
# container.
# FCM_SERVICE_ACCOUNT=

# RUST_LOG=atlas_server=debug,tower_http=info

# Static site (web/'s built dist) to serve on unmatched paths. Set
# automatically by the Docker image (see Dockerfile); leave unset locally
# unless you've built web/ and want to test serving it from this binary.
# STATIC_DIR=/app/web-dist

# Hostname (no port, case-insensitive) that gets the API only — visiting it
# in a browser 404s instead of showing the marketing site. Set this to your
# API subdomain (e.g. s.atlasmsg.app) so the same deploy can serve the site
# on the apex domain and act as a bare backend on the subdomain. /api/* and
# /ws are unaffected either way.
# API_ONLY_HOSTNAME=s.atlasmsg.app

# Bearer token gating GET /api/waitlist and the live SSE stream at
# /api/waitlist/stream (checked against the X-Admin-Token header). Unset
# (default) = those endpoints 404, not open.
# WAITLIST_ADMIN_TOKEN=

# Atlas Spaces (POST /api/spaces/generate) reuses Compass's inference gateway
# connection (COMPASS_API_KEY) — only the model differs. Generation is
# disabled whenever COMPASS_API_KEY is unset, same as Compass.
# SPACES_MODEL=glm-5.1
