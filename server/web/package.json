{
  "name": "atlas-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "cargo build --manifest-path ./wasm/atlas-e2ee/Cargo.toml --target wasm32-unknown-unknown --release && wasm-bindgen ./wasm/atlas-e2ee/target/wasm32-unknown-unknown/release/atlas_e2ee.wasm --out-dir ../../src/lib/e2ee-wasm --target web --out-name atlas_e2ee && bun ./wasm/patch-safari.mjs",
    "dev": "bun run build:wasm && vite",
    "build": "bun run build:wasm && vite build",
    "serve": "vite preview"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.8",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "@solidjs/router": "^0.16.2",
    "@vgpu/wgsl": "^0.3.1",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "phosphor-solid-js": "^2.0.0",
    "solid-js": "^1.9.3",
    "solid-transition-group": "^0.3.0",
    "vgpu": "^0.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.10.2",
    "autoprefixer": "^10.5.4",
    "babel-plugin-jsx-dom-expressions": "^0.40.10",
    "postcss": "^8.5.22",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0"
  }
}
