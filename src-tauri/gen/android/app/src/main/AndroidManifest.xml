<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Audio/video calls (WebRTC in the system WebView) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Push notifications. Required from Android 13 (API 33) and must also be
         granted at runtime — see MainActivity. Without it FCM messages still
         arrive but notifications are silently dropped. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.atlas"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Native Experimental" prototype (see src/screens/settings/Dev.tsx): a
             plain-Views chat list + chat screen that talks to the same REST API
             directly, bypassing the WebView entirely. Reached via a custom-scheme
             deep link so no custom Tauri plugin/JNI bridge is needed — the JS side
             calls plugin-opener's openUrl("atlas-native://open?..."), Android
             routes it straight back into this activity. -->
        <activity
            android:name=".native.NativeChatListActivity"
            android:label="Atlas (Native)"
            android:theme="@style/Theme.atlas"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="atlas-native" android:host="open" />
            </intent-filter>
        </activity>
        <activity
            android:name=".native.NativeChatActivity"
            android:label="Atlas (Native)"
            android:theme="@style/Theme.atlas"
            android:exported="false" />

        <!-- Receives the server's data-only pushes (server/src/push.rs) and
             posts the notification after fetching + decrypting the message. -->
        <service
            android:name=".push.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
