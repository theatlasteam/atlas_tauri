<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Audio/video calls (WebRTC in the system WebView) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Push notifications. Required from Android 13 (API 33) and must also be
         granted at runtime — see MainActivity. Without it FCM messages still
         arrive but notifications are silently dropped. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Full-screen incoming-call UI on a locked device. On API 34+ this is
         only auto-granted to apps registered as calling apps, so the call
         notification treats it as best-effort and degrades to heads-up. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.atlas"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- Multi-window: opt into Activity Embedding (tablets/foldables). -->
        <property
            android:name="android.window.PROPERTY_ACTIVITY_EMBEDDING_SPLITS_ENABLED"
            android:value="true" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SecondaryActivity"
            android:label="@string/main_activity_title"
            android:theme="@style/Theme.atlas"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:exported="false" />

        <!-- "Native Experimental" prototype (see src/screens/settings/Dev.tsx): a
             plain-Views chat list + chat screen that talks to the same REST API
             directly, bypassing the WebView entirely. Reached via a custom-scheme
             deep link so no custom Tauri plugin/JNI bridge is needed — the JS side
             calls plugin-opener's openUrl("atlas-native://open?..."), Android
             routes it straight back into this activity. -->
        <activity
            android:name=".native.NativeChatListActivity"
            android:label="Atlas (Native)"
            android:theme="@style/Theme.atlas"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="atlas-native" android:host="open" />
            </intent-filter>
        </activity>
        <activity
            android:name=".native.NativeChatActivity"
            android:label="Atlas (Native)"
            android:theme="@style/Theme.atlas"
            android:exported="false" />

        <!-- Receives the server's data-only pushes (server/src/push.rs) and
             posts the notification after fetching + decrypting the message. -->
        <service
            android:name=".push.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Full-screen ring screen. showWhenLocked/turnScreenOn are what let it
             appear over the keyguard; without them the activity launches but
             stays hidden behind the lock screen. excludeFromRecents keeps a
             dismissed call out of the recents list. -->
        <activity
            android:name=".push.IncomingCallActivity"
            android:theme="@style/Theme.atlas"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:exported="false" />

        <!-- Decline on the incoming-call notification: posts to the server
             directly, so it works with the app not running. -->
        <receiver
            android:name=".push.CallActionReceiver"
            android:exported="false" />

        <provider
          android:name="androidx.startup.InitializationProvider"
          android:authorities="${applicationId}.androidx-startup"
          android:exported="false"
          tools:node="merge">
          <meta-data
            android:name="get.ahmed.atlas.SplitInitializer"
            android:value="androidx.startup" />
        </provider>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
