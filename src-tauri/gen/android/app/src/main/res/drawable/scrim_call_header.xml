<?xml version="1.0" encoding="utf-8"?>
<!-- Darkens the mesh behind the caller text. Without it the bright blobs pass
     directly under the label and it becomes unreadable. angle=270 runs the
     gradient top -> bottom. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:startColor="#A6000000"
        android:centerColor="#40000000"
        android:endColor="#00000000" />
</shape>
