<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0C0E">

    <get.ahmed.atlas.push.MeshGradientView
        android:id="@+id/call_mesh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.55" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="96dp"
        android:paddingBottom="56dp"
        android:paddingHorizontal="32dp">

        <TextView
            android:id="@+id/call_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Incoming call"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.12" />

        <FrameLayout
            android:layout_width="148dp"
            android:layout_height="148dp"
            android:layout_marginTop="40dp">

            <View
                android:id="@+id/call_avatar_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_call_avatar_ring" />

            <ImageView
                android:id="@+id/call_avatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:contentDescription="Caller" />
        </FrameLayout>

        <TextView
            android:id="@+id/call_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:text=""
            android:textColor="#FFFFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/call_decline"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:padding="22dp"
                    android:background="@drawable/bg_call_decline"
                    android:src="@drawable/ic_call_decline"
                    android:scaleType="fitCenter"
                    android:contentDescription="Decline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Decline"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/call_answer"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:padding="22dp"
                    android:background="@drawable/bg_call_answer"
                    android:src="@drawable/ic_call_answer"
                    android:scaleType="fitCenter"
                    android:contentDescription="Answer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Answer"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
